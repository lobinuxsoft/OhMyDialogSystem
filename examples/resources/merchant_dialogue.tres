[sub_resource type="Resource" id="node_after_sample_ai"]
script = ExtResource("7_ai")
prompt_template = "Ask the customer if they want to buy more potions now that they got a free sample. Be persuasive but friendly."
emotion_hint = "friendly"
max_tokens = 60
node_id = "after_sample_ai_response"
editor_position = Vector2(1660, 20)

[sub_resource type="Resource" id="node_bow_ai"]
script = ExtResource("7_ai")
prompt_template = "The customer chose the elven bow! Thank them and mention it's crafted by elves. Be brief."
emotion_hint = "happy"
max_tokens = 60
node_id = "bow_ai_response"
editor_position = Vector2(1360, -260)

[sub_resource type="Resource" id="node_bow_event"]
script = ExtResource("11_event")
event_name = "item_purchased"
event_data = {
"item": "elven_bow",
"merchant": "Marcus",
"price": 120
}
node_id = "bow_purchase_event"
editor_position = Vector2(1680, -220)

[sub_resource type="Resource" id="node_bribe_ai"]
script = ExtResource("7_ai")
prompt_template = "The player offered to pay for secret information. Accept the bribe with greedy excitement and hint that you have access to a secret black market. Be brief and mysterious."
emotion_hint = "greedy"
max_tokens = 70
node_id = "bribe_ai_response"
editor_position = Vector2(1620, 340)

[sub_resource type="Resource" id="node_cancel_static"]
script = ExtResource("8_static")
speaker = "Marcus"
text = "No problem, my friend! Come back anytime!"
emotion = "neutral"
node_id = "cancel_static"
editor_position = Vector2(1360, 20)

[sub_resource type="Resource" id="node_end"]
script = ExtResource("6_end")
node_id = "end_node"
editor_position = Vector2(2640, 380)
output_count = 0

[sub_resource type="Resource" id="node_forget_static"]
script = ExtResource("8_static")
speaker = "Marcus"
text = "*looks relieved* Good, good. Some things are better left unknown, friend."
emotion = "relieved"
node_id = "forget_static"
editor_position = Vector2(1620, 700)

[sub_resource type="Resource" id="node_free_sample"]
script = ExtResource("8_static")
speaker = "Marcus"
text = "*hands you a small vial* Here, take this minor healing potion as a free sample! Now then..."
emotion = "generous"
node_id = "free_sample_static"
editor_position = Vector2(1020, 100)

[sub_resource type="Resource" id="node_goodbye_ai"]
script = ExtResource("7_ai")
prompt_template = "The player is leaving. Say a brief, slightly sad farewell hoping they'll return to shop another time."
emotion_hint = "sad"
max_tokens = 50
node_id = "goodbye_ai_response"
editor_position = Vector2(740, 1080)

[sub_resource type="Resource" id="node_increment_visits"]
script = ExtResource("12_setvar")
variable = "merchant_visits"
operation = 1
value = 1
node_id = "increment_visits"
editor_position = Vector2(1000, 1080)

[sub_resource type="Resource" id="node_main_choice"]
script = ExtResource("9_choice")
choices = PackedStringArray("I want to buy weapons.", "Show me your potions.", "Tell me a secret...", "Goodbye!")
node_id = "main_choice"
editor_position = Vector2(400, 200)
output_count = 4

[sub_resource type="Resource" id="node_not_trusted_static"]
script = ExtResource("8_static")
speaker = "Marcus"
text = "*narrows eyes* I don't know you well enough, stranger. Perhaps if you were more... established in these parts."
emotion = "suspicious"
node_id = "not_trusted_static"
editor_position = Vector2(1320, 800)

[sub_resource type="Resource" id="node_potions_ai"]
script = ExtResource("7_ai")
prompt_template = "The customer wants potions! Respond enthusiastically about your healing potions. Be brief."
emotion_hint = "happy"
max_tokens = 60
node_id = "potions_ai_response"
editor_position = Vector2(740, 120)

[sub_resource type="Resource" id="node_reputation_check"]
script = ExtResource("10_condition")
variable = "player_reputation"
operator = 3
value = 50
node_id = "reputation_condition"
editor_position = Vector2(1020, 460)
output_count = 2

[sub_resource type="Resource" id="node_sample_event"]
script = ExtResource("11_event")
event_name = "item_received"
event_data = {
"item": "minor_healing_potion",
"type": "free_sample"
}
node_id = "sample_event"
editor_position = Vector2(1360, 180)

[sub_resource type="Resource" id="node_secret_ai"]
script = ExtResource("7_ai")
prompt_template = "The player asked about secrets. Marcus should be suspicious and evasive, maybe hint at something illegal but not reveal too much. Be mysterious."
emotion_hint = "mysterious"
max_tokens = 80
node_id = "secret_ai_response"
editor_position = Vector2(740, 460)

[sub_resource type="Resource" id="node_secret_choice_trusted"]
script = ExtResource("9_choice")
choices = PackedStringArray("I can pay well for information...", "Forget I asked.")
node_id = "secret_choice_trusted"
editor_position = Vector2(1320, 320)
output_count = 2

[sub_resource type="Resource" id="node_secret_unlock_event"]
script = ExtResource("11_event")
event_name = "secret_shop_unlocked"
event_data = {
"merchant": "Marcus",
"secret_type": "black_market"
}
node_id = "secret_unlock_event"
editor_position = Vector2(1880, 400)

[sub_resource type="Resource" id="node_set_talked"]
script = ExtResource("12_setvar")
variable = "talked_to_merchant"
value = true
node_id = "set_talked_variable"
editor_position = Vector2(150, 200)

[sub_resource type="Resource" id="node_start"]
script = ExtResource("5_start")
node_id = "start_node"
editor_position = Vector2(-400, 200)

[sub_resource type="Resource" id="node_sword_ai"]
script = ExtResource("7_ai")
prompt_template = "The customer chose the enchanted sword! Thank them for the purchase and say something about the sword being a fine choice."
emotion_hint = "happy"
max_tokens = 60
node_id = "sword_ai_response"
editor_position = Vector2(1360, -600)

[sub_resource type="Resource" id="node_sword_event"]
script = ExtResource("11_event")
event_name = "item_purchased"
event_data = {
"item": "enchanted_sword",
"merchant": "Marcus",
"price": 150
}
node_id = "sword_purchase_event"
editor_position = Vector2(1680, -380)

[sub_resource type="Resource" id="node_weapons_ai"]
script = ExtResource("7_ai")
prompt_template = "Acknowledge the customer wants weapons. Mention you have an enchanted sword and an elven bow. Be enthusiastic but brief."
emotion_hint = "excited"
max_tokens = 60
node_id = "weapons_ai_response"
editor_position = Vector2(740, -280)

[sub_resource type="Resource" id="node_weapons_choice"]
script = ExtResource("9_choice")
choices = PackedStringArray("I\'ll take the enchanted sword!", "The elven bow looks nice.", "Actually, never mind.")
node_id = "weapons_choice"
editor_position = Vector2(1020, -280)
output_count = 3

[sub_resource type="Resource" id="node_welcome"]
script = ExtResource("8_static")
speaker = "Marcus"
text = "Welcome, traveler! I am Marcus, the finest merchant in Eldoria. What can I do for you today?"
emotion = "happy"
node_id = "welcome_static"
editor_position = Vector2(-100, 200)

