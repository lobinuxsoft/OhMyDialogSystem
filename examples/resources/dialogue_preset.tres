[gd_resource type="Resource" script_class="AIPreset" load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/ohmydialog/resources/ai_preset.gd" id="1"]

[resource]
script = ExtResource("1")
preset_name = "Dialogue Roleplay"
description = "Optimized for short, in-character dialogue responses. Uses stop sequences to prevent rambling."
preset_type = 4
temperature = 0.7
top_p = 0.9
top_k = 40
min_p = 0.05
typical_p = 1.0
max_tokens = 64
stop_sequences = ["\n###", "\nPlayer:", "\n\n\n", "\nUser:", "\nHuman:", "</s>", "<|im_end|>", "<|endoftext|>"]
repeat_penalty = 1.15
repeat_last_n = 64
frequency_penalty = 0.0
presence_penalty = 0.0
