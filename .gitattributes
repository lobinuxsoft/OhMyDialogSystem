# Auto detect text files and perform LF normalization
* text=auto

# Force LF for shell scripts (critical for Unix execution)
*.sh text eol=lf
*.bash text eol=lf

# Force LF for other script types
*.py text eol=lf
*.gd text eol=lf

# Source code (LF normalized)
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cs text eol=lf

# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Godot specific
*.tscn text eol=lf
*.tres text eol=lf
*.gdextension text eol=lf
*.import text eol=lf

# Documentation
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.gguf binary
*.onnx binary

# Godot binary resources
*.res binary
